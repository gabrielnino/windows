<?xml version="1.0" encoding="utf-8"?>
<Configuration><ViewDefinitions><View>
<Name>AuroraFiles</Name>
<ViewSelectedBy><TypeName>System.IO.DirectoryInfo</TypeName><TypeName>System.IO.FileInfo</TypeName></ViewSelectedBy>
<GroupBy><PropertyName>PSParentPath</PropertyName><Label>Directorio</Label></GroupBy>
<TableControl><TableHeaders>
<TableColumnHeader><Label>Modo</Label><Width>7</Width></TableColumnHeader>
<TableColumnHeader><Label>Modificado</Label><Width>19</Width></TableColumnHeader>
<TableColumnHeader><Label>Bytes</Label><Width>12</Width><Alignment>Right</Alignment></TableColumnHeader>
<TableColumnHeader><Label>Nombre</Label></TableColumnHeader>
</TableHeaders><TableRowEntries><TableRowEntry><TableColumnItems>
<TableColumnItem><PropertyName>Mode</PropertyName></TableColumnItem>
<TableColumnItem><ScriptBlock>$_.LastWriteTime.ToString('yyyy-MM-dd HH:mm')</ScriptBlock></TableColumnItem>
<TableColumnItem><ScriptBlock>if (-not $_.PSIsContainer) { $_.Length }</ScriptBlock></TableColumnItem>
<TableColumnItem><ScriptBlock>Format-AuroraFileName -Item $_</ScriptBlock></TableColumnItem>
</TableColumnItems></TableRowEntry></TableRowEntries></TableControl>
</View></ViewDefinitions></Configuration>
