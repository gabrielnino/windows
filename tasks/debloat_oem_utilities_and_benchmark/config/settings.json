{
  "task_name": "debloat_oem_utilities_and_benchmark",
  "version": "1.0.0",
  "iterations": 3,
  "debloat_targets": {
    "asus_services": [
      "AsusAppService",
      "ASUSSoftwareManager",
      "ASUSSwitch",
      "ASUSSystemAnalysis",
      "ASUSSystemDiagnosis"
    ],
    "telemetry_services": [
      "DiagTrack",
      "dmwappushservice",
      "dptftcs",
      "DPS",
      "InventorySvc",
      "wuqisvc",
      "MapsBroker"
    ],
    "asus_scheduled_tasks": [
      "ASUS Live Update 2.0",
      "ASUS Update Checker 2.0",
      "AsusSystemDiagnosis_DriverQuality"
